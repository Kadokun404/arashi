{
  "name": "arashi-base-polosan",
  "version": "1.0.0",
  "description": "Arashi WhatsApp Bot - Base Polosan (Menu, Prefix Manager, Plugin Manager)",
  "main": "launcher.js",
  "type": "module",
  "scripts": {
    "start": "node launcher.js",
    "bot": "node src/bot.js"
  },
  "dependencies": {
    "@cacheable/node-cache": "latest",
    "baileys": "^7.0.0-rc14",
    "dotenv": "^18.0.9",
    "pino": "latest",
    "qrcode-terminal": "latest",
    "ws": "^8.21.0"
  },
  "imports": {
    "#core/*": "./src/core/*",
    "#database/*": "./src/database/*",
    "#store/*": "./src/store/*",
    "#manager/*": "./src/manager/*",
    "#serializer/*": "./src/serializer/*",
    "#types/*": "./src/types/*",
    "#root/*": "./*"
  }
}